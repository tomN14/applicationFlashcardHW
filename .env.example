# App URLs (browser-safe: used in client redirects and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (browser: anon client; safe to expose with RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only: bypasses RLS — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Stripe (browser: Checkout / Elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (server only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_INBOX_EMAIL=

# OpenAI (server only: AI flashcard generation — never use NEXT_PUBLIC_OPENAI_API_KEY)
OPENAI_API_KEY=
